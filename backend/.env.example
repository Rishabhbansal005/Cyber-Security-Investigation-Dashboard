SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

SECRET_KEY=your-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

ENVIRONMENT=development
LOG_LEVEL=debug

# Storage
STORAGE_BUCKET=forensic_uploads
MAX_FILE_SIZE_MB=500

# Optional: Forensic Tool Paths (for future integration)
VOLATILITY_PATH=/usr/local/bin/vol
WIRESHARK_PATH=/usr/bin/wireshark
AUTOPSY_API_URL=http://localhost:9999/api
FTK_API_URL=http://localhost:8888/api

# OSINT & AI Integration Governance
ALIENVAULT_OTX_KEY=your_alienvault_api_key
SHODAN_API_KEY=your_shodan_api_key
GNEWS_API_KEY=
AI_MODE=disabled # Options: disabled | local_only | cloud_approved
AI_PROVIDER=local # Options: local | cloud
AI_BASE_URL=http://localhost:11434/v1 # OpenAI-compatible endpoint (Ollama, vLLM, OpenAI, etc.)
AI_API_KEY=your_ai_api_key_or_ollama
AI_MODEL_NAME=llama3
CLOUD_APPROVED_FOR_REAL_DATA=false # Must be true to process real_case_data with cloud provider
